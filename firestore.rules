rules_version = '2';

// Household — Firestore security rules.
//
// Private app: accounts are created by the admin in the Firebase console and self sign-up is
// disabled there (AUTH-08), so every rule starts with isSignedIn(). Anything not matched
// below is denied.
//
// Structure:
//   users/{uid}                        own profile only                       (Phase 1)
//   households/{hid}                   members read, owner updates            (Phase 2)
//   households/{hid}/members           members read, own doc only             (Phase 2)
//   households/{hid}/tasks             members CRUD, validated                (Phases 3, 4)
//   households/{hid}/shoppingItems     members CRUD, validated                (Phase 5)
//   households/{hid}/itemStats         members create / count ±1;             (Phase 5)
//                                      owner deletes only while deleting      (Phase 9)
//   households/{hid}/events            members CRUD, validated                (Phases 6, 7)
//   households/{hid}/activity          members create, append-only (owner     (Phase 2)
//                                      deletes only while deleting, Phase 9);
//                                      feed list by createdAt, optionally      (Phase 8)
//                                      by targetType (firestore.indexes.json)
//   invites/{code}                     get without a household or as a member (Phases 2, 9)
//
// Multi-document writes (create a household, join, new code, profile edits; Phase 9: leave,
// remove, hand over, delete) are single batches. The rules cross-check the other documents
// of a batch with getAfter(), so an incomplete batch is rejected as a whole (NFR-05).
//
// Phase 9: a household with `demo: true` (set only with the Admin SDK) can't be left,
// emptied, handed over, deleted or renamed, and its members can't change their names.
//
// Emulator tests: src/tests/rules/.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function memberPath(hid, uid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(uid);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    // The caller's profile before / after the current write or batch.
    function profile() {
      return get(userPath(request.auth.uid)).data;
    }

    function profileAfter() {
      return getAfter(userPath(request.auth.uid)).data;
    }

    function isMember(hid) {
      return isSignedIn() && request.auth.uid in get(householdPath(hid)).data.memberIds;
    }

    function isMemberAfter(hid) {
      return isSignedIn() && request.auth.uid in getAfter(householdPath(hid)).data.memberIds;
    }

    function isOwner(hid) {
      return isSignedIn() && get(householdPath(hid)).data.ownerId == request.auth.uid;
    }

    // Demo household (Phase 9 C4, C5): `demo` is set only with the Admin SDK (the household
    // key lists exclude it). It blocks the actions that would break the demo for everyone.
    function isDemoHousehold(hid) {
      return hid is string && get(householdPath(hid)).data.get('demo', false) == true;
    }

    // Deletion in progress (Phase 9 B7): only the owner is left in memberIds.
    function isDeletingHousehold(hid) {
      return get(householdPath(hid)).data.get('deleting', false) == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Invite codes: three letters without I/O, a dash, four digits (src/domain/invite.ts).
    function isInviteCode(code) {
      return code is string && code.matches('^[A-HJ-NP-Z]{3}-[0-9]{4}$');
    }

    // A code expires 7 days after it was created (HH-03).
    function inviteValidUntil(createdAt) {
      return createdAt + duration.value(7, 'd');
    }

    function validDisplayName(value) {
      return value is string && value.size() >= 1 && value.size() <= 50;
    }

    function validInitials(value) {
      return value is string && value.size() >= 1 && value.size() <= 2;
    }

    function validAvatarColor(value) {
      return value is int && value >= 1 && value <= 8;
    }

    // Shopping item names (Phase 5 B3): the client cleans them on save, so they never start
    // or end with whitespace, have no runs of it and no whitespace other than a plain space
    // (RE2's \s is ASCII-only, which is why the client also turns NBSP and other Unicode
    // spaces into plain spaces).
    function validShopName(value) {
      return value is string && value.size() >= 1 && value.size() <= 100
        && !value.matches('(?s)(\\s.*|.*\\s|.*\\s\\s.*|.*[^ \\S].*)');
    }

    function validShopCategory(value) {
      return value in ['groceries', 'household', 'pharmacy', 'other'];
    }

    // users/{uid}: own profile only.
    match /users/{uid} {
      function validNewProfile() {
        let data = request.resource.data;
        return data.keys().hasOnly(
            ['displayName', 'email', 'initials', 'avatarColor', 'householdId', 'createdAt'])
          && data.keys().hasAll(
            ['displayName', 'email', 'initials', 'avatarColor', 'householdId', 'createdAt'])
          && validDisplayName(data.displayName)
          && data.email == request.auth.token.email
          && validInitials(data.initials)
          && validAvatarColor(data.avatarColor)
          && data.householdId == null
          && data.createdAt == request.time;
      }

      // A demo user's name stays (Phase 9 C5); the avatar colour may change.
      function validProfileUpdate() {
        let data = request.resource.data;
        return changedKeys().hasOnly(['displayName', 'initials', 'avatarColor'])
          && validDisplayName(data.displayName)
          && validInitials(data.initials)
          && validAvatarColor(data.avatarColor)
          && (!changedKeys().hasAny(['displayName', 'initials'])
            || !isDemoHousehold(resource.data.householdId));
      }

      // Creating or joining a household: null → hid, only together with the membership.
      // Never from one household to another (one household per user).
      function validHouseholdIdSet() {
        let hid = request.resource.data.householdId;
        return changedKeys().hasOnly(['householdId'])
          && resource.data.householdId == null
          && hid is string
          && request.auth.uid in getAfter(householdPath(hid)).data.memberIds;
      }

      // Leaving, or healing a stale id (Phase 9 B2, B6): hid → null once I'm no longer in
      // that household's memberIds after the write, or it's gone (removed, deleted).
      function validHouseholdIdClear() {
        let old = resource.data.householdId;
        return changedKeys().hasOnly(['householdId'])
          && request.resource.data.householdId == null
          && old is string
          && (!existsAfter(householdPath(old))
            || !(request.auth.uid in getAfter(householdPath(old)).data.memberIds));
      }

      allow get: if isSelf(uid);
      allow create: if isSelf(uid) && validNewProfile();
      allow update: if isSelf(uid)
        && (validProfileUpdate() || validHouseholdIdSet() || validHouseholdIdClear());
      allow list, delete: if false;
    }

    // households/{hid}: members read; owner changes settings and the code; a joiner adds
    // only themself, proving they know the current, unexpired code.
    match /households/{hid} {
      function validName(value) {
        return value is string && value.size() >= 1 && value.size() <= 50;
      }

      function validWeekStart(value) {
        return value is int && value in [0, 1];
      }

      // Mirrors TIME_ZONES in src/domain/timeZones.ts (a rules test keeps them in sync).
      function validTimeZone(value) {
        return value in [
          'Europe/Zurich', 'Europe/Berlin', 'Europe/Vienna', 'Europe/Rome', 'Europe/Paris',
          'Europe/London', 'Europe/Lisbon', 'America/New_York', 'Asia/Tokyo'
        ];
      }

      // Create batch: household + members/{uid} (owner) + invites/{code} + users/{uid}.
      function validNewHousehold() {
        let data = request.resource.data;
        let uid = request.auth.uid;
        let keys = ['name', 'ownerId', 'memberIds', 'weekStartsOn', 'timeZone', 'inviteCode',
                    'inviteCreatedAt', 'createdAt', 'updatedAt'];
        return data.keys().hasOnly(keys) && data.keys().hasAll(keys)
          && data.ownerId == uid
          && data.memberIds == [uid]
          && validName(data.name)
          && validWeekStart(data.weekStartsOn)
          && validTimeZone(data.timeZone)
          && isInviteCode(data.inviteCode)
          && data.inviteCreatedAt == request.time
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && profile().householdId == null
          && profileAfter().householdId == hid
          && getAfter(memberPath(hid, uid)).data.role == 'owner'
          && getAfter(invitePath(data.inviteCode)).data.householdId == hid;
      }

      // Default order of new rotations (HH-07, Phase 4 B11): members only, no duplicates.
      function validRotationOrder(value) {
        return value is list
          && value.size() <= 20
          && value.toSet().size() == value.size()
          && value.hasOnly(resource.data.memberIds);
      }

      // rotationOrder is checked only when it changes, so an order that still holds a
      // former member doesn't block renaming the household. A demo household keeps its name
      // (Phase 9 C5).
      function isSettingsUpdate() {
        let data = request.resource.data;
        return resource.data.ownerId == request.auth.uid
          && changedKeys().hasOnly(['name', 'weekStartsOn', 'timeZone', 'rotationOrder',
                                    'updatedAt'])
          && data.updatedAt == request.time
          && validName(data.name)
          && validWeekStart(data.weekStartsOn)
          && validTimeZone(data.timeZone)
          && (!('rotationOrder' in changedKeys()) || validRotationOrder(data.rotationOrder))
          && (!('name' in changedKeys()) || !isDemo());
      }

      function isDemo() {
        return resource.data.get('demo', false) == true;
      }

      function isDeleting() {
        return resource.data.get('deleting', false) == true;
      }

      // The lifecycle writes (Phase 9) never touch a demo household or one being deleted.
      function isLifecycleAllowed() {
        return !isDemo() && !isDeleting();
      }

      // rotationOrder after `uids` left: the same order without them (absent stays absent).
      function rotationOrderWithout(uids) {
        return request.resource.data.get('rotationOrder', [])
          == resource.data.get('rotationOrder', []).removeAll(uids);
      }

      // Leave batch (Phase 9 B1, B2): a member (not the owner) takes only themself out of
      // memberIds and rotationOrder, deletes their member doc and clears their profile's
      // householdId in the same batch.
      function isLeave() {
        let data = request.resource.data;
        let uid = request.auth.uid;
        return isLifecycleAllowed()
          && uid in resource.data.memberIds
          && resource.data.ownerId != uid
          && changedKeys().hasOnly(['memberIds', 'rotationOrder', 'updatedAt'])
          && data.updatedAt == request.time
          && data.memberIds == resource.data.memberIds.removeAll([uid])
          && rotationOrderWithout([uid])
          && !existsAfter(memberPath(hid, uid))
          && profileAfter().householdId == null;
      }

      // Remove batch (Phase 9 B4): the owner takes exactly one other member out of memberIds
      // and rotationOrder and deletes their member doc in the same batch.
      function isRemoveMember() {
        let data = request.resource.data;
        let removed = resource.data.memberIds.removeAll(data.memberIds);
        return isLifecycleAllowed()
          && resource.data.ownerId == request.auth.uid
          && changedKeys().hasOnly(['memberIds', 'rotationOrder', 'updatedAt'])
          && data.updatedAt == request.time
          && removed.size() == 1
          && removed[0] != request.auth.uid
          && data.memberIds == resource.data.memberIds.removeAll(removed)
          && rotationOrderWithout(removed)
          && !existsAfter(memberPath(hid, removed[0]));
      }

      // Hand-over batch (Phase 9 B5): ownerId moves to another member, and both member docs
      // swap their role in the same batch.
      function isHandOver() {
        let data = request.resource.data;
        let uid = request.auth.uid;
        return isLifecycleAllowed()
          && resource.data.ownerId == uid
          && changedKeys().hasOnly(['ownerId', 'updatedAt'])
          && data.updatedAt == request.time
          && data.ownerId != uid
          && data.ownerId in resource.data.memberIds
          && getAfter(memberPath(hid, data.ownerId)).data.role == 'owner'
          && getAfter(memberPath(hid, uid)).data.role == 'member';
      }

      // First step of a delete (Phase 9 B7): `deleting` set, only the owner left in
      // memberIds (everyone else is shut out at once and heals, B6), no rotation order.
      function isStartDelete() {
        let data = request.resource.data;
        let uid = request.auth.uid;
        return isLifecycleAllowed()
          && resource.data.ownerId == uid
          && changedKeys().hasOnly(['deleting', 'memberIds', 'rotationOrder', 'updatedAt'])
          && data.deleting == true
          && data.memberIds == [uid]
          && data.get('rotationOrder', []) == []
          && data.updatedAt == request.time;
      }

      // New code batch: delete the old invite + create the new one + this update (HH-03).
      function isNewCode() {
        let data = request.resource.data;
        return resource.data.ownerId == request.auth.uid
          && changedKeys().hasOnly(['inviteCode', 'inviteCreatedAt', 'updatedAt'])
          && isInviteCode(data.inviteCode)
          && data.inviteCode != resource.data.inviteCode
          && data.inviteCreatedAt == request.time
          && data.updatedAt == request.time
          && getAfter(invitePath(data.inviteCode)).data.householdId == hid
          && !existsAfter(invitePath(resource.data.inviteCode));
      }

      // Join batch: memberIds arrayUnion(uid) + members/{uid} (joinedWithCode) +
      // users/{uid}.householdId + invite memberCount + activity «member_joined».
      function isJoin() {
        let data = request.resource.data;
        let uid = request.auth.uid;
        return !(uid in resource.data.memberIds)
          && !isDeleting()
          && data.memberIds == resource.data.memberIds.concat([uid])
          && changedKeys().hasOnly(['memberIds', 'updatedAt'])
          && data.updatedAt == request.time
          && request.time < inviteValidUntil(resource.data.inviteCreatedAt)
          && profile().householdId == null
          && profileAfter().householdId == hid
          && getAfter(memberPath(hid, uid)).data.joinedWithCode == resource.data.inviteCode;
      }

      allow get: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow list: if false;
      allow create: if isSignedIn() && validNewHousehold();
      allow update: if isSignedIn()
        && (isSettingsUpdate() || isNewCode() || isJoin() || isLeave() || isRemoveMember()
          || isHandOver() || isStartDelete());
      // Last step of a delete (Phase 9 B7): only after isStartDelete, never a demo household.
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && isDeleting()
        && !isDemo();

      // members/{uid}: the member's profile, copied for display.
      match /members/{uid} {
        function matchesProfile(data) {
          let p = profile();
          return data.displayName == p.displayName
            && data.initials == p.initials
            && data.avatarColor == p.avatarColor;
        }

        // Inside the create batch, for the new owner.
        function validOwnerMember() {
          let data = request.resource.data;
          let keys = ['displayName', 'initials', 'avatarColor', 'role', 'joinedAt'];
          return !exists(householdPath(hid))
            && getAfter(householdPath(hid)).data.ownerId == uid
            && data.keys().hasOnly(keys) && data.keys().hasAll(keys)
            && data.role == 'owner'
            && matchesProfile(data)
            && data.joinedAt == request.time;
        }

        // Inside the join batch, with the household's current code.
        function validJoinerMember() {
          let data = request.resource.data;
          let before = get(householdPath(hid)).data;
          let keys = ['displayName', 'initials', 'avatarColor', 'role', 'joinedAt',
                      'joinedWithCode'];
          return !(uid in before.memberIds)
            && uid in getAfter(householdPath(hid)).data.memberIds
            && data.keys().hasOnly(keys) && data.keys().hasAll(keys)
            && data.role == 'member'
            && data.joinedWithCode == before.inviteCode
            && matchesProfile(data)
            && data.joinedAt == request.time;
        }

        // Only together with the same change on the profile (memberService.updateMyProfile).
        // A demo user's name stays (Phase 9 C5).
        function validMemberUpdate() {
          let data = request.resource.data;
          let p = profileAfter();
          return changedKeys().hasOnly(['displayName', 'initials', 'avatarColor'])
            && data.displayName == p.displayName
            && data.initials == p.initials
            && data.avatarColor == p.avatarColor
            && (!changedKeys().hasAny(['displayName', 'initials']) || !isDemoHousehold(hid));
        }

        // Hand-over (Phase 9 B5): the old owner sets their own role to member and the new
        // owner's to owner, in the batch that moves ownerId.
        function isRoleSwap() {
          let before = get(householdPath(hid)).data;
          let after = getAfter(householdPath(hid)).data;
          let role = request.resource.data.role;
          return changedKeys().hasOnly(['role'])
            && before.ownerId == request.auth.uid
            && after.ownerId != request.auth.uid
            && ((uid == after.ownerId && role == 'owner')
              || (uid == request.auth.uid && role == 'member'));
        }

        // Leaving, removal and deletion (Phase 9 B2, B4, B7): the doc goes once the member
        // is out of memberIds after the batch, or the household itself is gone. Oneself, or
        // the owner for anyone.
        function isGoneAfter() {
          return !existsAfter(householdPath(hid))
            || !(uid in getAfter(householdPath(hid)).data.memberIds);
        }

        allow get, list: if isMember(hid);
        allow create: if isSelf(uid) && (validOwnerMember() || validJoinerMember());
        allow update: if (isSelf(uid) && validMemberUpdate()) || (isSignedIn() && isRoleSwap());
        allow delete: if (isSelf(uid) || isOwner(hid)) && isGoneAfter();
      }

      // Recurrence rules, shared by tasks (Phase 4 B2, B3; mirrors validateRule in
      // src/domain/recurrence.ts) and events (Phase 7 B1; mirrors validateEventRule).
      // Weekdays 0 = Sunday … 6 = Saturday; monthly and yearly only with interval 1.
      function validMonthDay(value) {
        return value is int && value >= 1 && value <= 31;
      }

      function validWeekdays(value) {
        return value is list
          && value.size() >= 1 && value.size() <= 7
          && value.hasOnly([0, 1, 2, 3, 4, 5, 6])
          && value.toSet().size() == value.size();
      }

      // The task shapes; `extraKeys` lets events add their end keys (until, count).
      function validRuleShape(rule, extraKeys) {
        return rule is map
          && rule.keys().hasAll(['freq', 'interval'])
          && rule.interval is int && rule.interval >= 1 && rule.interval <= 52
          && ((rule.freq == 'daily'
              && rule.keys().hasOnly(['freq', 'interval'].concat(extraKeys)))
            || (rule.freq == 'weekly'
              && rule.keys().hasOnly(['freq', 'interval', 'byWeekday'].concat(extraKeys))
              && validWeekdays(rule.get('byWeekday', null)))
            || (rule.freq == 'monthly'
              && rule.keys().hasOnly(['freq', 'interval', 'byMonthDay'].concat(extraKeys))
              && rule.interval == 1
              && validMonthDay(rule.get('byMonthDay', null)))
            || (rule.freq == 'yearly'
              && rule.keys().hasOnly(['freq', 'interval', 'byMonth', 'byMonthDay']
                                       .concat(extraKeys))
              && rule.interval == 1
              && rule.get('byMonth', null) is int
              && rule.byMonth >= 1 && rule.byMonth <= 12
              && validMonthDay(rule.get('byMonthDay', null))));
      }

      // Tasks: no bySetPos, until or count.
      function validRecurrence(rule) {
        return validRuleShape(rule, []);
      }

      // Events (Phase 7 B1): the task shapes or monthly by weekday («Am 1. Samstag», D60:
      // one weekday + bySetPos 1–4 / -1, no byMonthDay), each with either `until`
      // («YYYY-MM-DD», inclusive) or `count` (2–99), never both (B5).
      function validEventRecurrence(rule) {
        return rule is map
          && !rule.keys().hasAll(['until', 'count'])
          && (!('until' in rule)
            || (rule.until is string && rule.until.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('count' in rule)
            || (rule.count is int && rule.count >= 2 && rule.count <= 99))
          && (validRuleShape(rule, ['until', 'count'])
            || (rule.get('freq', null) == 'monthly'
              && rule.keys().hasAll(['freq', 'interval', 'byWeekday', 'bySetPos'])
              && rule.keys().hasOnly(['freq', 'interval', 'byWeekday', 'bySetPos', 'until',
                                      'count'])
              && rule.interval == 1
              && rule.byWeekday is list && rule.byWeekday.size() == 1
              && rule.byWeekday.hasOnly([0, 1, 2, 3, 4, 5, 6])
              && rule.bySetPos in [1, 2, 3, 4, -1]));
      }

      // tasks/{taskId} (Phase 3): every member reads and writes every task (requirements §3).
      // A write either edits fields, completes (open → done) or reopens (done → open).
      // Phase 4: recurring tasks carry recurrence, rotation, seriesId and seriesIndex.
      match /tasks/{taskId} {
        function validTitle(value) {
          return value is string && value.size() <= 200 && value.trim().size() >= 1;
        }

        function validNotes(value) {
          return value is string && value.size() >= 1 && value.size() <= 2000;
        }

        function validPriority(value) {
          return value in ['low', 'medium', 'high'];
        }

        // A calendar date «2026-10-03» (NFR-09) or null. Checks months 01–12 and days 01–31
        // only, so «2026-02-31» passes; harmless, the client only writes real dates.
        function validDueDate(value) {
          return value == null
            || (value is string
              && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
        }

        function validAssignee(value) {
          return value == null
            || (value is string && value in get(householdPath(hid)).data.memberIds);
        }

        // Rotation (RTK-05, Phase 4 B4): current members, no duplicates, and the assignee is
        // the member at `index`.
        function validRotation(rotation, assigneeId) {
          return rotation is map
            && rotation.keys().hasOnly(['memberIds', 'index'])
            && rotation.keys().hasAll(['memberIds', 'index'])
            && rotation.memberIds is list
            && rotation.memberIds.size() >= 2 && rotation.memberIds.size() <= 20
            && rotation.memberIds.toSet().size() == rotation.memberIds.size()
            && rotation.memberIds.hasOnly(get(householdPath(hid)).data.memberIds)
            && rotation.index is int
            && rotation.index >= 0 && rotation.index < rotation.memberIds.size()
            && assigneeId == rotation.memberIds[rotation.index];
        }

        // Series (Phase 4 B5): a first occurrence has any new seriesId (a fresh random id per
        // series); a generated one has the id «{seriesId}-{seriesIndex}». A set over an
        // existing generated occurrence counts as an update and fails isEdit (createdAt
        // changes), so a second «Nur diese» or completion can't create it twice.
        function validSeries(data) {
          return data.seriesId is string
            && data.seriesId.size() >= 1 && data.seriesId.size() <= 60
            && data.seriesIndex is int && data.seriesIndex >= 1
            && (data.seriesIndex == 1
              || taskId == data.seriesId + '-' + string(data.seriesIndex));
        }

        // The repeat fields of a task as a whole: a rule needs a due date (RTK-02) and a
        // series; a rotation needs a rule and matches the assignee; no series without a rule
        // on a new task.
        function validRepeatState(data) {
          return (!('recurrence' in data) || (data.dueDate != null && 'seriesId' in data))
            && (!('rotation' in data)
              || ('recurrence' in data
                && data.rotation.memberIds[data.rotation.index] == data.assigneeId));
        }

        function validNewTask() {
          let data = request.resource.data;
          return data.keys().hasOnly(['title', 'notes', 'assigneeId', 'dueDate', 'priority',
                                      'status', 'seriesId', 'seriesIndex', 'recurrence',
                                      'rotation', 'createdBy', 'createdAt', 'updatedAt'])
            && data.keys().hasAll(['title', 'assigneeId', 'dueDate', 'priority', 'status',
                                   'createdBy', 'createdAt', 'updatedAt'])
            && validTitle(data.title)
            && (!('notes' in data) || validNotes(data.notes))
            && validAssignee(data.assigneeId)
            && validDueDate(data.dueDate)
            && validPriority(data.priority)
            && (('recurrence' in data && validRecurrence(data.recurrence) && validSeries(data))
              || (!('recurrence' in data) && !('seriesId' in data) && !('seriesIndex' in data)))
            && (!('rotation' in data) || validRotation(data.rotation, data.assigneeId))
            && validRepeatState(data)
            && data.status == 'open'
            && data.createdBy == request.auth.uid
            && data.createdAt == request.time
            && data.updatedAt == request.time;
        }

        // Edit: only the editable fields change; the assignee and the rotation are checked
        // only when they change, so a task of someone who left (Phase 9) stays editable. A
        // task that gets a rule starts a new series (seriesIndex 1, a seriesId it didn't
        // have, B5).
        function isEdit() {
          let data = request.resource.data;
          let changed = changedKeys();
          return changed.hasOnly(['title', 'notes', 'assigneeId', 'dueDate', 'priority',
                                  'recurrence', 'rotation', 'seriesId', 'seriesIndex',
                                  'updatedAt'])
            && data.updatedAt == request.time
            && (!('title' in changed) || validTitle(data.title))
            && (!('notes' in changed) || !('notes' in data) || validNotes(data.notes))
            && (!('assigneeId' in changed) || validAssignee(data.assigneeId))
            && (!('dueDate' in changed) || validDueDate(data.dueDate))
            && (!('priority' in changed) || validPriority(data.priority))
            && (!('recurrence' in changed) || !('recurrence' in data)
              || validRecurrence(data.recurrence))
            && (!('rotation' in changed) || !('rotation' in data)
              || validRotation(data.rotation, data.assigneeId))
            && (!changed.hasAny(['seriesId', 'seriesIndex'])
              || (!('recurrence' in resource.data)
                && 'recurrence' in data
                && validSeries(data)
                && data.seriesIndex == 1
                && data.seriesId != resource.data.get('seriesId', '')))
            && ('recurrence' in resource.data || !('recurrence' in data)
              || 'seriesId' in changed)
            && validRepeatState(data);
        }

        function isComplete() {
          let data = request.resource.data;
          return resource.data.status == 'open'
            && data.status == 'done'
            && changedKeys().hasOnly(['status', 'completedAt', 'completedBy', 'updatedAt'])
            && data.completedAt == request.time
            && data.completedBy == request.auth.uid
            && data.updatedAt == request.time;
        }

        // Reopen; a completed occurrence may drop its rule and rotation in the same write
        // (reopened as a normal task, Phase 4 B9), but never gain one.
        function isReopen() {
          let data = request.resource.data;
          let changed = changedKeys();
          return resource.data.status == 'done'
            && data.status == 'open'
            && changed.hasOnly(['status', 'completedAt', 'completedBy', 'recurrence',
                                'rotation', 'updatedAt'])
            && !('completedAt' in data)
            && !('completedBy' in data)
            && (!('recurrence' in changed) || !('recurrence' in data))
            && (!('rotation' in changed) || !('rotation' in data))
            && validRepeatState(data)
            && data.updatedAt == request.time;
        }

        allow get, list: if isMember(hid);
        allow create: if isMember(hid) && validNewTask();
        allow update: if isMember(hid) && (isEdit() || isComplete() || isReopen());
        allow delete: if isMember(hid);
      }

      // shoppingItems/{itemId} (Phase 5 B1): every member reads and writes every item. A write
      // either edits fields, checks (open → checked, by oneself, at server time) or unchecks.
      // A create is a new open item, or the restore of a checked one after «Gekaufte
      // entfernen» (B7). The item rules never look at itemStats, so an uncheck without a
      // stats change is valid (B6).
      match /shoppingItems/{itemId} {
        function validQuantity(value) {
          return value is string && value.size() >= 1 && value.size() <= 30;
        }

        function validItemNotes(value) {
          return value is string && value.size() >= 1 && value.size() <= 500;
        }

        function validNewItem() {
          let data = request.resource.data;
          return data.keys().hasOnly(['name', 'quantity', 'notes', 'category', 'checked',
                                      'checkedAt', 'checkedBy', 'createdBy', 'createdAt',
                                      'updatedAt'])
            && data.keys().hasAll(['name', 'category', 'checked', 'createdBy', 'createdAt',
                                   'updatedAt'])
            && validShopName(data.name)
            && (!('quantity' in data) || validQuantity(data.quantity))
            && (!('notes' in data) || validItemNotes(data.notes))
            && validShopCategory(data.category)
            && data.createdAt == request.time
            && data.updatedAt == request.time
            && ((data.checked == false
                && data.createdBy == request.auth.uid
                && !('checkedAt' in data)
                && !('checkedBy' in data))
              // Restore (B7): as it was, checked, possibly created and bought by others.
              || (data.checked == true
                && data.createdBy is string && data.createdBy.size() >= 1
                && data.get('checkedBy', null) is string && data.checkedBy.size() >= 1
                && data.get('checkedAt', null) is timestamp
                && data.checkedAt <= request.time));
        }

        function isItemEdit() {
          let data = request.resource.data;
          let changed = changedKeys();
          return changed.hasOnly(['name', 'quantity', 'notes', 'category', 'updatedAt'])
            && data.updatedAt == request.time
            && (!('name' in changed) || validShopName(data.name))
            && (!('quantity' in changed) || !('quantity' in data)
              || validQuantity(data.quantity))
            && (!('notes' in changed) || !('notes' in data) || validItemNotes(data.notes))
            && (!('category' in changed) || validShopCategory(data.category));
        }

        function isItemCheck() {
          let data = request.resource.data;
          return resource.data.checked == false
            && data.checked == true
            && changedKeys().hasOnly(['checked', 'checkedAt', 'checkedBy', 'updatedAt'])
            && data.checkedAt == request.time
            && data.checkedBy == request.auth.uid
            && data.updatedAt == request.time;
        }

        function isItemUncheck() {
          let data = request.resource.data;
          return resource.data.checked == true
            && data.checked == false
            && changedKeys().hasOnly(['checked', 'checkedAt', 'checkedBy', 'updatedAt'])
            && !('checkedAt' in data)
            && !('checkedBy' in data)
            && data.updatedAt == request.time;
        }

        allow get, list: if isMember(hid);
        allow create: if isMember(hid) && validNewItem();
        allow update: if isMember(hid) && (isItemEdit() || isItemCheck() || isItemUncheck());
        allow delete: if isMember(hid);
      }

      // itemStats/{key} (Phase 5 B1, B6): purchase history for the suggestions. The id is the
      // lowercased name with «/» as «∕» (statKey in src/domain/shopping.ts; the name is
      // already cleaned, B3). A purchase creates it with count 1 or adds 1; an uncheck takes
      // 1 away (best effort, never below 0). Never deleted: it outlives «Gekaufte entfernen».
      match /itemStats/{key} {
        // lower() only lowercases ASCII letters («ÄPFEL» stays «ÄPFEL», emulator-tested), so
        // the key is checked exactly for ASCII names only; for other names it only has to be
        // a plausible id (fallback in Phase 5 §5.4). The key can never block a check-off.
        function keyMatches(name) {
          return key == name.lower().replace('/', '∕')
            || (name.matches('(?s).*[^\\x00-\\x7F].*') && key.size() >= 1 && key.size() <= 200);
        }

        function validNewStat() {
          let data = request.resource.data;
          return data.keys().hasOnly(['name', 'category', 'count', 'lastPurchasedAt'])
            && data.keys().hasAll(['name', 'category', 'count', 'lastPurchasedAt'])
            && validShopName(data.name)
            && validShopCategory(data.category)
            && keyMatches(data.name)
            && data.count == 1
            && data.lastPurchasedAt == request.time;
        }

        function isPurchase() {
          let data = request.resource.data;
          return changedKeys().hasOnly(['name', 'category', 'count', 'lastPurchasedAt'])
            && data.count == resource.data.count + 1
            && data.lastPurchasedAt == request.time
            && validShopName(data.name)
            && validShopCategory(data.category)
            && keyMatches(data.name);
        }

        function isUnpurchase() {
          let data = request.resource.data;
          return changedKeys().hasOnly(['count'])
            && data.count == resource.data.count - 1
            && data.count >= 0;
        }

        allow get, list: if isMember(hid);
        allow create: if isMember(hid) && validNewStat();
        allow update: if isMember(hid) && (isPurchase() || isUnpurchase());
        // Only while the owner deletes the household (Phase 9 B7).
        allow delete: if isOwner(hid) && isDeletingHousehold(hid);
      }

      // events/{eventId} (Phase 6 B1–B3, B5, B13): any member creates, edits and deletes.
      // Participants are checked on create and when they change (Phase 9 B19), so an event
      // that still lists a former member stays editable; the client drops them on save (B5).
      // Timed events store instants; all-day events floating dates at 00:00 UTC with an
      // inclusive end (B2). A recurring event (Phase 7) stores its first occurrence and a rule
      // (validEventRecurrence), and single occurrences cancelled or changed in `exceptions`
      // (Phase 9 B10), written one key at a time (isExceptionEdit).
      match /events/{eventId} {
        function validEventTitle(value) {
          return value is string && value.size() >= 1 && value.size() <= 200
            && value.trim() == value;
        }

        function validEventCategory(value) {
          return value in ['social', 'appointment', 'travel', 'home', 'reminder', 'other'];
        }

        // «household», or 1–20 distinct uids of current members.
        function validParticipants(value) {
          return value == 'household'
            || (value is list
              && value.size() >= 1 && value.size() <= 20
              && value.toSet().size() == value.size()
              && value.hasOnly(get(householdPath(hid)).data.memberIds));
        }

        // CAL-05, B3: end ≥ start; at most 366 calendar days, i.e. 366 days between the
        // instants of a timed event and 365 between the first and last day of an all-day one.
        function validEventTimes(data) {
          let dayMs = 86400000;
          let length = data.end.toMillis() - data.start.toMillis();
          return data.start is timestamp && data.end is timestamp
            && length >= 0
            && ((data.allDay == false && length <= 366 * dayMs)
              || (data.allDay == true
                && data.start.toMillis() % dayMs == 0
                && data.end.toMillis() % dayMs == 0
                && length <= 365 * dayMs));
        }

        function validDescription(value) {
          return value is string && value.size() >= 1 && value.size() <= 2000;
        }

        // `exceptions` (Phase 9 B10) only on a series; `lastExceptionKey` only with them.
        function validEventData(data, checkParticipants) {
          return data.keys().hasOnly(['title', 'description', 'category', 'allDay', 'start',
                                      'end', 'participants', 'recurrence', 'exceptions',
                                      'lastExceptionKey', 'createdBy', 'createdAt',
                                      'updatedAt'])
            && data.keys().hasAll(['title', 'category', 'allDay', 'start', 'end',
                                   'participants', 'createdBy', 'createdAt', 'updatedAt'])
            && validEventTitle(data.title)
            && (!('description' in data) || validDescription(data.description))
            && validEventCategory(data.category)
            && data.allDay is bool
            && validEventTimes(data)
            && (!checkParticipants || validParticipants(data.participants))
            && (!('recurrence' in data) || validEventRecurrence(data.recurrence))
            && (!('exceptions' in data) || 'recurrence' in data)
            && data.updatedAt == request.time;
        }

        function validNewEvent() {
          let data = request.resource.data;
          return validEventData(data, true)
            && !('exceptions' in data)
            && !('lastExceptionKey' in data)
            && data.createdBy == request.auth.uid
            && data.createdAt == request.time;
        }

        // An edit of the event as a whole may only drop the exceptions (Phase 9 B12: a new
        // rule, start or times reset them), never write them.
        function isEventEdit() {
          let data = request.resource.data;
          return validEventData(data, 'participants' in changedKeys())
            && (!changedKeys().hasAny(['exceptions', 'lastExceptionKey'])
              || (!('exceptions' in data) && !('lastExceptionKey' in data)))
            && data.createdBy == resource.data.createdBy
            && data.createdAt == resource.data.createdAt;
        }

        // One exception (REV-07, Phase 9 B10): cancelled, or an override with new times and the
        // fields that differ from the series; validated like the event, «Ganztägig» stays the
        // series' own.
        function validException(value) {
          return value is map
            && ((value.keys().hasOnly(['cancelled']) && value.get('cancelled', false) == true)
              || (value.keys().hasOnly(['start', 'end', 'title', 'description', 'category',
                                        'participants'])
                && value.keys().hasAll(['start', 'end'])
                && value.start is timestamp && value.end is timestamp
                && validEventTimes({ 'allDay': resource.data.allDay, 'start': value.start,
                                     'end': value.end })
                && (!('title' in value) || validEventTitle(value.title))
                && (!('description' in value) || validDescription(value.description))
                && (!('category' in value) || validEventCategory(value.category))
                && (!('participants' in value) || validParticipants(value.participants))));
        }

        // Exception write (Phase 9 B10): rules can't read an element of a Set, so the write
        // names its key in `lastExceptionKey`, and exactly that key may change.
        function isExceptionEdit() {
          let data = request.resource.data;
          let key = data.get('lastExceptionKey', null);
          return 'recurrence' in resource.data
            && changedKeys().hasOnly(['exceptions', 'lastExceptionKey', 'updatedAt'])
            && data.updatedAt == request.time
            && key is string
            && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.exceptions is map
            && data.exceptions.size() <= 100
            && data.exceptions.diff(resource.data.get('exceptions', {})).affectedKeys()
              .hasOnly([key])
            && key in data.exceptions
            && validException(data.exceptions[key]);
        }

        allow get, list: if isMember(hid);
        allow create: if isMember(hid) && validNewEvent();
        allow update: if isMember(hid) && (isEventEdit() || isExceptionEdit());
        allow delete: if isMember(hid);
      }

      // activity/{id}: append-only (ACT-06).
      match /activity/{activityId} {
        function taskPath(taskId) {
          return /databases/$(database)/documents/households/$(hid)/tasks/$(taskId);
        }

        function itemPath(itemId) {
          return /databases/$(database)/documents/households/$(hid)/shoppingItems/$(itemId);
        }

        function nullableString(value) {
          return value == null || value is string;
        }

        // task_assigned: old and new assignee with name snapshots («Vorher: Nevio»).
        function validAssignDetails(details) {
          return details is map
            && details.keys().hasOnly(['fromId', 'fromName', 'toId', 'toName'])
            && details.keys().hasAll(['fromId', 'fromName', 'toId', 'toName'])
            && nullableString(details.fromId)
            && nullableString(details.fromName)
            && nullableString(details.toId)
            && nullableString(details.toName);
        }

        // Task entries (Phase 3): written in the same batch as the task, whose title after
        // the batch is the snapshot; a completion entry needs the task to be done.
        function validTaskActivity(data) {
          let task = taskPath(data.targetId);
          return data.type in ['task_created', 'task_completed', 'task_assigned']
            && data.targetType == 'task'
            && isMember(hid)
            && existsAfter(task)
            && getAfter(task).data.title == data.targetTitle
            && (data.type != 'task_completed' || getAfter(task).data.status == 'done')
            && ((data.type == 'task_assigned' && 'details' in data
                && validAssignDetails(data.details))
              || (data.type != 'task_assigned' && !('details' in data)));
        }

        // Shopping entries (Phase 5 B11): written in the same batch as the item, whose name
        // after the batch is the snapshot; «item_added» needs an open item, «item_purchased»
        // a checked one.
        function validItemActivity(data) {
          let item = itemPath(data.targetId);
          return data.type in ['item_added', 'item_purchased']
            && data.targetType == 'item'
            && isMember(hid)
            && existsAfter(item)
            && getAfter(item).data.name == data.targetTitle
            && getAfter(item).data.checked == (data.type == 'item_purchased')
            && !('details' in data);
        }

        function eventPath(eventId) {
          return /databases/$(database)/documents/households/$(hid)/events/$(eventId);
        }

        // Calendar entries (Phase 6 B12): «event_created» in the same batch as the event,
        // whose title after the batch is the snapshot.
        function validEventActivity(data) {
          let event = eventPath(data.targetId);
          return data.type == 'event_created'
            && data.targetType == 'event'
            && isMember(hid)
            && existsAfter(event)
            && getAfter(event).data.title == data.targetTitle
            && !('details' in data);
        }

        function validMemberJoined(data) {
          let uid = request.auth.uid;
          return data.type == 'member_joined'
            && (!('details' in data) || data.details is map)
            && (isMember(hid)
              // The joiner (not a member before the batch) records their own join.
              || (data.targetType == 'member'
                && data.targetId == uid
                && isMemberAfter(hid)));
        }

        // Leaving (Phase 9 B8): in the leave batch, about oneself.
        function validMemberLeft(data) {
          let uid = request.auth.uid;
          return data.type == 'member_left'
            && data.targetType == 'member'
            && data.targetId == uid
            && !('details' in data)
            && uid in get(householdPath(hid)).data.memberIds
            && !(uid in getAfter(householdPath(hid)).data.memberIds);
        }

        // Removal (Phase 9 B8): in the owner's remove batch, about the removed member.
        function validMemberRemoved(data) {
          return data.type == 'member_removed'
            && data.targetType == 'member'
            && isOwner(hid)
            && data.targetId in get(householdPath(hid)).data.memberIds
            && !(data.targetId in getAfter(householdPath(hid)).data.memberIds)
            && !('details' in data);
        }

        function validNewActivity() {
          let data = request.resource.data;
          return data.keys().hasOnly(['actorId', 'type', 'targetType', 'targetId',
                                      'targetTitle', 'details', 'createdAt'])
            && data.keys().hasAll(['actorId', 'type', 'targetType', 'targetId', 'targetTitle',
                                   'createdAt'])
            && data.actorId == request.auth.uid
            && data.createdAt == request.time
            && data.targetType is string
            && data.targetId is string
            && data.targetTitle is string
            && (validMemberJoined(data) || validTaskActivity(data) || validItemActivity(data)
              || validEventActivity(data) || validMemberLeft(data)
              || validMemberRemoved(data));
        }

        allow get, list: if isMember(hid);
        allow create: if isSignedIn() && validNewActivity();
        allow update: if false;
        // Append-only (ACT-06), except while the owner deletes the household (Phase 9 B7).
        allow delete: if isOwner(hid) && isDeletingHousehold(hid);
      }
    }

    // invites/{code}: lookup for the join flow. Users without a household may get a code
    // (needed before joining), nobody may list them.
    match /invites/{code} {
      function validNewInvite() {
        let data = request.resource.data;
        let household = getAfter(householdPath(data.householdId)).data;
        let keys = ['householdId', 'householdName', 'ownerName', 'memberCount', 'createdBy',
                    'createdAt'];
        return isInviteCode(code)
          && data.keys().hasOnly(keys) && data.keys().hasAll(keys)
          && data.householdId is string
          && household.ownerId == request.auth.uid
          && household.inviteCode == code
          && data.householdName == household.name
          && data.memberCount == household.memberIds.size()
          && data.ownerName == profile().displayName
          && data.createdBy == request.auth.uid
          && data.createdAt == request.time;
      }

      // The preview stays current in the batches that change it. memberCount is checked
      // relative to its old value, so a drifted count never blocks a join or profile edit.
      function validInviteUpdate() {
        let data = request.resource.data;
        let hid = resource.data.householdId;
        let keys = changedKeys();
        return isMemberAfter(hid)
          && keys.hasOnly(['householdName', 'ownerName', 'memberCount'])
          && (!('householdName' in keys)
            || data.householdName == getAfter(householdPath(hid)).data.name)
          && (!('ownerName' in keys)
            || (getAfter(householdPath(hid)).data.ownerId == request.auth.uid
              && data.ownerName == profileAfter().displayName))
          && (!('memberCount' in keys)
            || (data.memberCount == resource.data.memberCount + 1
              && !(request.auth.uid in get(householdPath(hid)).data.memberIds)));
      }

      // Leaving or removal (Phase 9 B9): −1 by someone who was a member before the batch,
      // in the batch that makes memberIds one shorter. Separate from validInviteUpdate,
      // because the leaver isn't a member afterwards.
      function isMemberCountDecrement() {
        let hid = resource.data.householdId;
        let before = get(householdPath(hid)).data.memberIds;
        return changedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && request.auth.uid in before
          && getAfter(householdPath(hid)).data.memberIds.size() == before.size() - 1;
      }

      // Hand-over (Phase 9 B5): the old owner writes the new owner's name.
      function isHandOverOwnerName() {
        let hid = resource.data.householdId;
        let after = getAfter(householdPath(hid)).data;
        return changedKeys().hasOnly(['ownerName'])
          && get(householdPath(hid)).data.ownerId == request.auth.uid
          && after.ownerId != request.auth.uid
          && request.resource.data.ownerName
            == getAfter(memberPath(hid, after.ownerId)).data.displayName;
      }

      // Lookup (Phase 9 C7): users without a household (joining), members of the code's
      // household, and codes that don't exist (the free-code check of «Neuer Code»). A
      // member of another household (e.g. a demo user) can't read someone else's preview.
      allow get: if isSignedIn()
        && (resource == null
          || profile().householdId == null
          || request.auth.uid in get(householdPath(resource.data.householdId)).data.memberIds);
      allow list: if false;
      allow create: if isSignedIn() && validNewInvite();
      allow update: if isSignedIn()
        && (validInviteUpdate() || isMemberCountDecrement() || isHandOverOwnerName());
      allow delete: if isOwner(resource.data.householdId);
    }
  }
}
