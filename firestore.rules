rules_version = '2';

// Household — Firestore security rules.
//
// Phase 0 baseline: deny everything. Each phase opens exactly the paths it needs,
// together with emulator tests in src/tests/rules/.
//
// Planned structure:
//   users/{uid}                        own profile only              (Phase 1)
//   households/{hid}                   members read, owner updates   (Phase 2)
//   households/{hid}/members|tasks|shoppingItems|itemStats|events    (Phases 2–7)
//   households/{hid}/activity          members create, append-only   (Phase 2)
//   invites/{code}                     get by signed-in users        (Phase 2)
//
// Helpers to add: isSignedIn(), isMember(hid), isOwner(hid), field validators.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
