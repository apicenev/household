# Used by `npm run dev:emu` (vite --mode emulator). No secrets: points at the
# local emulator suite with a demo-* project ID, which needs no real Firebase project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-household.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-household
VITE_FIREBASE_STORAGE_BUCKET=demo-household.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_EMULATORS=true
